{
  "name": "ai-pm-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "AI PM client v2: cross-platform scheduler and agent runner",
  "type": "module",
  "main": "dist/main/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && vite build -c vite.renderer.config.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "start": "npm run build && electron .",
    "cli": "tsx src/cli.ts",
    "smoke:codex": "tsx scripts/smoke-real-codex.ts",
    "demo": "tsx scripts/demo-ui.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "ajv": "8.20.0",
    "lucide-react": "1.53.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.9.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.0.4"
  }
}
